APP_DOMAIN=schedule.example.com
PUBLIC_BASE_URL=https://schedule.example.com

POSTGRES_PASSWORD=replace-with-long-random-password
APP_SECRET=replace-with-long-random-secret

ADMIN_PASSWORD=replace-with-initial-admin-login-password
SEED_USER_PASSWORD=replace-with-temporary-seeded-user-password
USER_STORE_PATH=/data/users.json

# Optional: set these only when scripts or external tools need API-key auth.
ADMIN_API_KEY=
VIEWER_API_KEY=
OPENROUTER_API_KEY=
CHAT_QUOTA_TIME_ZONE=America/New_York
QGENDA_SYNC_ENABLED=true
QGENDA_PUBLIC_LINK_URL=https://app.qgenda.com/Link/view?linkKey=replace-with-published-link-key
QGENDA_SYNC_TIME_ZONE=America/New_York
QGENDA_SYNC_MONTHS_PAST=1
QGENDA_SYNC_MONTHS_FUTURE=3
QGENDA_SYNC_ON_START=true
QGENDA_PUBLIC_TASK_MAP_JSON=
QGENDA_PUBLIC_STAFF_MAP_JSON=
